{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/project.schema.json",
  "title": "EmbrAIon Project Overlay",
  "type": "object",
  "required": [
    "framework",
    "project"
  ],
  "properties": {
    "framework": {
      "type": "object",
      "required": [
        "repository",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "data-class": {
                "enum": [
                  "PUBLIC",
                  "PRIVATE",
                  "CONFIDENTIAL"
                ]
              },
              "trust": {
                "enum": [
                  "project",
                  "external",
                  "generated"
                ]
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "triggers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "canonical": {
          "$ref": "#/$defs/pathPatterns"
        },
        "protected": {
          "$ref": "#/$defs/pathPatterns"
        },
        "generated": {
          "$ref": "#/$defs/pathPatterns"
        },
        "external": {
          "$ref": "#/$defs/pathPatterns"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "substantial-required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "default-class": {
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "CONFIDENTIAL"
          ]
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "routing": false
  },
  "$defs": {
    "pathPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
