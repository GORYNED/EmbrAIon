{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/project.schema.json",
  "title": "EmbrAIon Project Overlay",
  "type": "object",
  "required": [
    "framework",
    "project"
  ],
  "properties": {
    "framework": {
      "type": "object",
      "required": [
        "repository",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "object",
          "required": [
            "schema",
            "source",
            "release",
            "asset",
            "digest"
          ],
          "properties": {
            "schema": {
              "type": "integer",
              "const": 1
            },
            "source": {
              "const": "github-release"
            },
            "release": {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "asset": {
              "type": "string",
              "pattern": "^embraion-[0-9]+\\.[0-9]+\\.[0-9]+-py3-none-any\\.whl$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "knowledge": false,
    "sources": false,
    "validation": false,
    "review": false,
    "privacy": false,
    "agents": false,
    "capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "routing": false,
    "deployments": false,
    "housekeeping": {
      "type": "object",
      "properties": {
        "on-task-start": {"type": "boolean", "default": false},
        "local-branches": {"type": "boolean", "default": true},
        "remote-branches": {"type": "boolean", "default": false},
        "worktrees": {"type": "boolean", "default": true},
        "preserve-branches": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {},
  "additionalProperties": true
}
