{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmbrAIon Learning Candidate",
  "type": "object",
  "required": [
    "schema-version",
    "id",
    "state",
    "kind",
    "confidence",
    "evidence",
    "proposed-target"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "state": {
      "enum": [
        "observed",
        "accumulating",
        "proposed",
        "approved",
        "rejected",
        "promoted"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "run-ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "eval-ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "proposed-target": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "rule",
            "skill",
            "workflow",
            "routing",
            "knowledge",
            "eval"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
