{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/execution.schema.json",
  "title": "EmbrAIon Execution Evidence",
  "type": "object",
  "required": [
    "schema-version",
    "run-id",
    "task",
    "role",
    "route",
    "access",
    "owned-paths",
    "workspace",
    "state",
    "started-utc",
    "updated-utc"
  ],
  "properties": {
    "schema-version": { "type": "integer", "minimum": 1 },
    "run-id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "route": {
      "type": "object",
      "required": ["host", "class", "model", "data-class"],
      "properties": {
        "host": { "type": "string" },
        "class": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": ["string", "null"] },
        "data-class": {
          "enum": ["PUBLIC", "PRIVATE", "CONFIDENTIAL"]
        }
      },
      "additionalProperties": false
    },
    "access": { "type": "string" },
    "owned-paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context-id": { "type": ["string", "null"] },
    "substantial": { "type": "boolean" },
    "workspace": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "changed-paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile", "status"],
        "properties": {
          "profile": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "review": { "type": "string" },
    "outcome": { "type": ["string", "null"] },
    "residual-risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "state": {
      "enum": ["active", "completed", "blocked", "failed", "cancelled"]
    },
    "started-utc": { "type": "string" },
    "updated-utc": { "type": "string" }
  },
  "additionalProperties": false
}
