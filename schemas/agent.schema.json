{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmbrAIon Agent",
  "type": "object",
  "required": ["schema-version", "id", "title", "purpose", "access", "model-neutral", "responsibilities", "restrictions", "triggers", "outputs"],
  "properties": {
    "schema-version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "access": { "enum": ["orchestrator", "read-only", "workspace-write"] },
    "model-neutral": { "const": true },
    "responsibilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "restrictions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "triggers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
