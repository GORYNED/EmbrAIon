{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/execution-request.schema.json",
  "title": "EmbrAIon executable request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "workItemId", "taskId", "role", "routeClass", "host", "dataClass", "sourceIds", "trustLevel", "access", "ownedPaths", "contextRef", "timeoutSeconds", "maxAttempts", "candidates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "routeClass": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "dataClass": {"enum": ["PUBLIC", "PRIVATE", "CONFIDENTIAL"]},
    "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trustLevel": {"type": "string", "minLength": 1},
    "access": {"enum": ["read-only", "workspace-write"]},
    "ownedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contextRef": {"type": "string", "minLength": 1},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 8},
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "object", "required": ["deployment"], "additionalProperties": false,
        "properties": {"deployment": {"type": "string", "minLength": 1}, "effort": {"type": "string"}, "options": {"type": "object"}}}
    },
    "payload": {"type": "object"}
  }
}
