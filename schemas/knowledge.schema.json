{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/knowledge.schema.json",
  "title": "EmbrAIon Project Knowledge",
  "type": "object",
  "$defs": {
    "knowledge-entry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "data-class": {
              "enum": [
                "PUBLIC",
                "PRIVATE",
                "CONFIDENTIAL"
              ]
            },
            "trust": {
              "enum": [
                "project",
                "external",
                "generated"
              ]
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "triggers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "slot-binding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/knowledge-entry"
        }
      ]
    }
  },
  "properties": {
    "slots": {
      "type": "object",
      "properties": {
        "constitution": {
          "$ref": "#/$defs/slot-binding"
        },
        "architecture": {
          "$ref": "#/$defs/slot-binding"
        },
        "source-authority": {
          "$ref": "#/$defs/slot-binding"
        },
        "compatibility": {
          "$ref": "#/$defs/slot-binding"
        },
        "persistence": {
          "$ref": "#/$defs/slot-binding"
        },
        "engineering-workflow": {
          "$ref": "#/$defs/slot-binding"
        },
        "specification": {
          "$ref": "#/$defs/slot-binding"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/knowledge-entry"
  }
}
