{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/knowledge.schema.json",
  "title": "EmbrAIon Project Knowledge",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      {
        "type": "string",
        "minLength": 1
      },
      {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "data-class": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "CONFIDENTIAL"
            ]
          },
          "trust": {
            "enum": [
              "project",
              "external",
              "generated"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    ]
  }
}
