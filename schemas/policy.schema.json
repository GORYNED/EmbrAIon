{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/policy.schema.json",
  "title": "EmbrAIon Project Policy",
  "type": "object",
  "required": [
    "sources",
    "review",
    "privacy",
    "enforcement"
  ],
  "properties": {
    "sources": {
      "type": "object",
      "required": [
        "canonical",
        "protected",
        "generated",
        "external"
      ],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/pathPatterns"
        },
        "protected": {
          "$ref": "#/$defs/pathPatterns"
        },
        "generated": {
          "$ref": "#/$defs/pathPatterns"
        },
        "external": {
          "$ref": "#/$defs/pathPatterns"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "substantial-required"
      ],
      "properties": {
        "substantial-required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "default-class"
      ],
      "properties": {
        "default-class": {
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "CONFIDENTIAL"
          ]
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": [
        "enabled",
        "validation-profile",
        "require-review"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "validation-profile": {
          "type": "string",
          "minLength": 1
        },
        "require-review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "description": "Optional checks for projected host configuration outside EmbrAIon-managed blocks.",
      "properties": {
        "codex": {
          "type": "object",
          "properties": {
            "strict-root": {
              "type": "boolean",
              "description": "Make projection verify fail on root findings in Codex merge mode."
            },
            "forbidden-root-keys": {
              "$ref": "#/$defs/keyPatterns",
              "description": "Additional dotted key patterns forbidden outside managed ownership; Core defaults always apply."
            },
            "allowed-root-keys": {
              "$ref": "#/$defs/keyPatterns",
              "description": "Optional allowlist of top-level keys; developer_instructions and agents are always allowed."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ceilings": {
      "type": "object",
      "description": "Project-declared maximum permissions that deployments, execution bindings, and routing may narrow but never widen.",
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "data-classes": {
                "type": "array",
                "items": {
                  "enum": [
                    "PUBLIC",
                    "PRIVATE",
                    "CONFIDENTIAL"
                  ]
                },
                "uniqueItems": true
              },
              "access-modes": {
                "type": "array",
                "items": {
                  "enum": [
                    "read-only",
                    "workspace-write"
                  ]
                },
                "uniqueItems": true
              },
              "roles": {
                "$ref": "#/$defs/names"
              },
              "sources": {
                "$ref": "#/$defs/names"
              },
              "binding-required-billing-modes": {
                "$ref": "#/$defs/names"
              }
            },
            "additionalProperties": false
          }
        },
        "data-classes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "CONFIDENTIAL"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "providers"
            ],
            "properties": {
              "providers": {
                "$ref": "#/$defs/names",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "providers"
            ],
            "properties": {
              "providers": {
                "$ref": "#/$defs/names",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "task-classes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "route-class": {
                "enum": [
                  "bounded-read",
                  "bounded-write",
                  "ordinary",
                  "substantial",
                  "complex",
                  "critical"
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "data-class": {
                "enum": [
                  "PUBLIC",
                  "PRIVATE",
                  "CONFIDENTIAL"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "critical": {
          "type": "object",
          "properties": {
            "justifications": {
              "$ref": "#/$defs/names",
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pathPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keyPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
