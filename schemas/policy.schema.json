{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/policy.schema.json",
  "title": "EmbrAIon Project Policy",
  "type": "object",
  "required": [
    "sources",
    "review",
    "privacy",
    "enforcement"
  ],
  "properties": {
    "sources": {
      "type": "object",
      "required": [
        "canonical",
        "protected",
        "generated",
        "external"
      ],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/pathPatterns"
        },
        "protected": {
          "$ref": "#/$defs/pathPatterns"
        },
        "generated": {
          "$ref": "#/$defs/pathPatterns"
        },
        "external": {
          "$ref": "#/$defs/pathPatterns"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "substantial-required"
      ],
      "properties": {
        "substantial-required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "default-class"
      ],
      "properties": {
        "default-class": {
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "CONFIDENTIAL"
          ]
        },
        "sources": {
          "type": "object",
          "description": "Optional data class of each stable source ID. When declared, an execution request may name only listed sources, and its data class must be at least the highest class of the sources it names.",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "CONFIDENTIAL"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": [
        "enabled",
        "validation-profile",
        "require-review"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "validation-profile": {
          "type": "string",
          "minLength": 1
        },
        "require-review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "description": "Optional merge policy. Omitted means human-only, the Core default.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "human-only",
            "owner-permission"
          ],
          "description": "human-only: a human merges. owner-permission: an agent may merge a pull request only with the owner's explicit permission for it, after required checks pass and the independent reviewer confirms its final head; auto-merge is never enabled."
        }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "description": "Optional checks for projected host configuration. Declared components are verified by `embraion check`.",
      "properties": {
        "codex": {
          "type": "object",
          "properties": {
            "strict-root": {
              "type": "boolean",
              "description": "Make projection verify fail on root findings in Codex merge mode."
            },
            "forbidden-root-keys": {
              "$ref": "#/$defs/keyPatterns",
              "description": "Additional dotted key patterns forbidden outside managed ownership; Core defaults always apply."
            },
            "allowed-root-keys": {
              "$ref": "#/$defs/keyPatterns",
              "description": "Optional allowlist of top-level keys; developer_instructions and agents are always allowed."
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "config",
                  "agents",
                  "skills"
                ]
              },
              "description": "Codex projection components that `embraion check` verifies."
            },
            "config-mode": {
              "enum": [
                "replace",
                "merge"
              ],
              "description": "Config mode used to verify the Codex config component; defaults to replace."
            }
          },
          "additionalProperties": false
        },
        "copilot": {
          "type": "object",
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "agents",
                  "skills"
                ]
              },
              "description": "Copilot projection components that `embraion check` verifies."
            }
          },
          "additionalProperties": false
        },
        "claude-code": {
          "type": "object",
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "agents",
                  "skills",
                  "scoped-agents",
                  "hooks"
                ]
              },
              "description": "Claude Code projection components that `embraion check` verifies; scoped-agents and hooks also gate `claude-native status`."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "description": "Optional options for `embraion check`. Command-line flags override them; omitted keys keep the previous behavior.",
      "properties": {
        "organization": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "full",
              "compare"
            ]
          },
          "description": "Organization-check modes to run: full audits the whole structure; compare checks against --base-ref and is not run without one. Omitted runs full without --base-ref and compare with it."
        },
        "fail-on": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Lowest security finding severity that fails the check; defaults to high."
        },
        "all-files": {
          "type": "boolean",
          "description": "Also scan every other text file in the security scan, as `security scan --all-files`; defaults to false."
        },
        "validation-profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Project validation profiles from .embraion/validation.yaml that `embraion check` runs as `validation run` does, after the other checks. Each must exist, have commands, and pass; omitted runs none."
        }
      },
      "additionalProperties": false
    },
    "ceilings": {
      "type": "object",
      "description": "Project-declared maximum permissions that deployments, execution bindings, and routing may narrow but never widen.",
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "data-classes": {
                "type": "array",
                "items": {
                  "enum": [
                    "PUBLIC",
                    "PRIVATE",
                    "CONFIDENTIAL"
                  ]
                },
                "uniqueItems": true
              },
              "access-modes": {
                "type": "array",
                "items": {
                  "enum": [
                    "read-only",
                    "workspace-write"
                  ]
                },
                "uniqueItems": true
              },
              "roles": {
                "$ref": "#/$defs/names"
              },
              "sources": {
                "$ref": "#/$defs/names"
              },
              "binding-required-billing-modes": {
                "$ref": "#/$defs/names"
              }
            },
            "additionalProperties": false
          }
        },
        "data-classes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "CONFIDENTIAL"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "providers"
            ],
            "properties": {
              "providers": {
                "$ref": "#/$defs/names",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "providers"
            ],
            "properties": {
              "providers": {
                "$ref": "#/$defs/names",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "task-classes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "route-class": {
                "enum": [
                  "bounded-read",
                  "bounded-write",
                  "ordinary",
                  "substantial",
                  "complex",
                  "critical"
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "data-class": {
                "enum": [
                  "PUBLIC",
                  "PRIVATE",
                  "CONFIDENTIAL"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "critical": {
          "type": "object",
          "properties": {
            "justifications": {
              "$ref": "#/$defs/names",
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pathPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keyPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
