{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/pricing-snapshot.schema.json",
  "title": "EmbrAIon validated pricing snapshot",
  "type": "object",
  "required": ["schemaVersion", "verifiedUtc", "digest", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "verifiedUtc": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "rates": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "input": {"$ref": "#/$defs/rate"},
        "cachedInput": {"$ref": "#/$defs/rate"},
        "output": {"$ref": "#/$defs/rate"},
        "reasoning": {"$ref": "#/$defs/rate"}
      }
    },
    "rate": {"type": "string", "pattern": "^(0|[0-9]+)(\\.[0-9]+)?$"},
    "schedule": {
      "type": "object", "required": ["kind", "peakUtcHours", "peak", "offPeak"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["utc-weekday", "utc-weekday-with-holidays"]},
        "holidaysUnverified": {"type": "boolean"},
        "peakUtcHours": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 23}, {"type": "integer", "minimum": 1, "maximum": 24}], "items": false, "minItems": 2, "maxItems": 2}
        },
        "peak": {"$ref": "#/$defs/rates"},
        "offPeak": {"$ref": "#/$defs/rates"}
      }
    },
    "entry": {
      "type": "object", "required": ["deployment", "sku", "sourceId", "sourceUrl", "sourceDigest", "retrievedUtc", "verifiedUtc", "currency", "unitTokens", "rates"],
      "additionalProperties": false,
      "properties": {
        "deployment": {"type": "string", "minLength": 1},
        "sku": {"type": "string", "minLength": 1},
        "sourceId": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "retrievedUtc": {"type": "string", "format": "date-time"},
        "verifiedUtc": {"type": "string", "format": "date-time"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "unitTokens": {"type": "integer", "minimum": 1},
        "rates": {"$ref": "#/$defs/rates"},
        "batch": {"$ref": "#/$defs/rates"},
        "discounts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/rates"}},
        "schedule": {"$ref": "#/$defs/schedule"},
        "effectiveDate": {"type": "string", "format": "date"},
        "validThrough": {"type": "string", "format": "date"},
        "maxInputTokens": {"type": "integer", "minimum": 1}
      }
    }
  }
}
