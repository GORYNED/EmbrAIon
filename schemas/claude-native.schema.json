{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in Claude native scoped assignments",
  "type": "object",
  "required": ["bindings", "assignments"],
  "properties": {
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "route-class", "data-class", "access"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "route-class": {"type": "string", "enum": ["bounded-read", "bounded-write", "ordinary", "substantial", "complex", "critical"]},
          "data-class": {"type": "string", "enum": ["PUBLIC", "PRIVATE", "CONFIDENTIAL"]},
          "access": {"type": "string", "enum": ["inspect", "plan", "review", "write", "external-read"]}
        },
        "additionalProperties": false
      }
    },
    "read-policy": {
      "type": "object",
      "properties": {
        "project-only": {"type": "boolean", "default": false},
        "deny-protected": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
