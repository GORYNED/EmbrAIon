{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmbrAIon MCP Inventory",
  "type": "object",
  "required": [
    "schema-version",
    "servers"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "minimum": 1
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "host",
          "state",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "state": {
            "enum": [
              "expected",
              "observed",
              "missing",
              "unexpected",
              "drifted",
              "unavailable"
            ]
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment-names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
