{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GORYNED/EmbrAIon/schemas/agents.schema.json",
  "title": "EmbrAIon Project Agents",
  "type": "object",
  "required": [
    "agents"
  ],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "access",
          "responsibilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "enum": [
              "read-only",
              "workspace-write"
            ]
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
